# PostgreSQL Database Configuration
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# For local development without Docker:
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5432/rag_db

# For Docker Compose:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@db:5432/rag_db

# RAG Ingestion Hyperparameters
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# LLM Generation (Optional: Can provide your Gemini API key or use local model)
GEMINI_API_KEY=
